{
  "name": "@manufosela/wabuse-cli",
  "version": "1.1.0",
  "description": "Wabuse. Web-components Interactive Tool UX is a builder SSR pages with Web Components",
  "type": "module",
  "main": "./lib/wabuse.mjs",
  "bin": {
    "wabuse": "./bin/index.mjs"
  },
  "scripts": {
    "prepare": "husky install",
    "format": "run-p format:*",
    "format:eclint": "git ls-files | xargs eclint fix",
    "format:eslint": "npm run lint:eslint -- --fix",
    "format:prettier": "prettier \"*\" --write --ignore-path .eslintignore",
    "lint": "run-p lint:*",
    "lint:eclint": "git ls-files | xargs eclint check",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier \"*\" --check --ignore-path .eslintignore",
    "test": "vitest"
  },
  "author": "manufosela",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">= 7.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.1",
    "inquire": "^0.4.8",
    "puppeteer": "^21.11.0",
    "shelljs": "^0.8.5",
    "vite": "^5.2.13",
    "vite-plugin-full-reload": "^1.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@open-wc/eslint-config": "^12.0.3",
    "chai": "^5.0.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-node": "^4.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.0.4",
    "eslint-plugin-lit": "^1.11.0",
    "eslint-plugin-lit-a11y": "^4.1.2",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-wc": "^2.0.4",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.1",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "standard-version": "^9.5.0",
    "vitest": "^1.6.0"
  }
}
